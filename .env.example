# Optional cloud sync API. The editor remains fully functional without it.
VITE_API_URL=http://localhost:8787
API_PORT=8787
DATABASE_URL=postgres://formforge:formforge@localhost:5432/formforge
OWNER_TOKEN=replace-with-a-long-random-token
SHARE_SECRET=replace-with-a-different-long-random-token

# Optional external image-to-3D provider. The Microsoft public Space is shared,
# quota-limited, and not a production SLA. Keep tokens server-side only.
TRELLIS_SPACE_ENABLED=false
TRELLIS_SPACE=microsoft/TRELLIS.2
HF_TOKEN=

# Optional local engineering model (disabled by default).
# Uses a local OpenAI-compatible /v1/chat/completions server, e.g. Ollama.
# Only loopback clients with loopback Host/Origin may use this route. A hosted
# PrintLab site cannot connect to this adapter. No OWNER_TOKEN is needed for
# this separately opted-in loopback route; other API routes keep their auth.
ENGINEERING_LOCAL_ENABLED=false
ENGINEERING_LOCAL_URL=http://127.0.0.1:11434/v1/chat/completions
# Set the exact model name already installed in your local inference server.
ENGINEERING_LOCAL_MODEL=
# Optional local-server credential, held only by the API process.
ENGINEERING_LOCAL_API_KEY=
# 1000-120000 ms; default 45000. Response text is capped at 256 KiB.
ENGINEERING_LOCAL_TIMEOUT_MS=45000
# Provider compatibility reference: https://docs.ollama.com/api/openai-compatibility
# Limits: 256 KiB request, 128 parametric nodes, 8000 prompt characters,
# one active request, six attempts per minute. Returned plans still require
# schema validation, review, geometry preview and explicit Apply in the editor.
# Local adapter tests: npm run test -w @formforge/api
